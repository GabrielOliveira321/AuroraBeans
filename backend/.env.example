# ============================================
# AuroraBeans - Backend Environment Variables
# ============================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ============================================

# --- Banco de Dados (PostgreSQL) ---
# URL de conexão com o PostgreSQL (docker-compose já configura o banco)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurorabens"

# --- JWT (Autenticação) ---
# Chave secreta para assinar tokens JWT
JWT_SECRET="coloque-uma-chave-secreta-forte-aqui"

# --- Stripe (Pagamentos) ---
# Chave secreta da API do Stripe (obtenha em https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Webhook secret do Stripe (obtenha no dashboard do Stripe > Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- CORS ---
# URL do frontend (para liberar o CORS)
FRONTEND_URL="http://localhost:3000"

# --- Servidor ---
# Porta onde o backend será executado (padrão: 8080)
PORT=8080
