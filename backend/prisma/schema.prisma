// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id       Int    @id @default(autoincrement())
  category String
  name     String @unique
  price    Float
  desc     String
  img      String
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}
